# Snowflake Cortex REST API (keep server-side; never commit .env)
SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_TOKEN=your-programmatic-access-token
SNOWFLAKE_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_MODEL=mistral-7b
# Optional: raises the GitHub API rate limit for public repos
GITHUB_TOKEN=
